# JWT Settings
# Required. Generate a unique random value with: openssl rand -hex 32
# Must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET_KEY=

# Google OAuth Settings
# Required — sign-in is the only way into the app, so the server will not
# start until all three are set. See the README for how to create these.
# The redirect URI must match the one registered in Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/backend/oauth/google/callback

# Where a failed sign-in lands. Set this on any deployment, or users who fail
# to log in are sent to localhost.
# AUTH_FAILURE_REDIRECT=http://localhost:3000/auth/failure

# Allowed browser origins. This is also the allowlist of hosts a user may be
# returned to after signing in, so the site's own origin must be listed.
CORS_ORIGINS='["http://localhost:3000"]'

# MongoDB Settings
# docker compose sets this for the local containers; uncomment only when
# running the backend outside Docker or against a hosted database.
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DATABASE=talleyrand

# Restrict who can sign in. Off by default, which means anyone with a Google
# account can use this instance.
# EMAIL_WHITELIST_ENABLED=true
# EMAIL_WHITELIST='["you@example.com"]'

# LOGGING_LEVEL=INFO
